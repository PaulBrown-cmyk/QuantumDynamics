!=============================== INPUT.nml ===================================
! Example INPUT.nml (NAMELIST) for two-state proton transfer dynamics.
! Chemistry-facing units:
!   lengths      : angstrom
!   times        : femtosecond
!   energies     : wavenumber (cm^-1)
!   rates        : fs^-1
!   wave number  : 1/angstrom
!   temperature  : kelvin
!   mass         : unified atomic mass units (u/amu)
! read_input() converts these immediately into atomic units for propagation.
!
! New in this update:
!   - Stochastic potential modulation (bath_pot_*): a random process R_t that modulates
!     the diabatic wells (reactant/product) in one of 3 modes.
!
&QLE
  ! Grid / time
  nx         = 4096,
  xmin       = -4.0000,
  xmax       =  4.0000,
  dt         = 0.10000,
  nsteps     = 20000,
  save_every = 25,
  ntraj      = 1,
  seed0      = 2468,

  ! Thermostat / friction (momentum-space Langevin/GLE)
  temperature_k = 300.0,
  mass_amu      = 1.00784, ! neutral hydrogen-atom transfer mass
  gamma      = 20.6707,
  damp_reactant = .false.,
  damp_product  = .true.,

  ! Noise kernel for momentum bath (optional)
  use_colored = .true.,
  kernel      = 'lorentz',
  fwhm        = 6.20121,

  ! Potential model. Well stiffness comes from k1/k2.
  pot_model   = 'harmonic',

  ! Two-parabola + coupling parameters (used when pot_model selects the two-surface form)
  ! k1/k2 are force constants in cm^-1 / Å^2, converted to atomic units on read.
  k1       = 2000.0,
  k2       = 2000.0,
  x1       = -2.0000,
  x2       =  2.0000,
  v1_shift =  0.0,
  v2_shift =  0.0,
  c4_1     =  0.0, ! quartic coefficient in cm^-1 / Å^4
  c4_2     =  0.0,
  v12      = 54868.7,
  sigma    = 0.01,

  ! Initial wavepacket
  x0      = -2.5000,
  p0      =  2.83459,
  sigma0  =  0.529177,

  ! Optional smooth absorbing edge layers (disabled here).
  use_absorber   = .false.,
  absorber_width = 0.5,  ! angstrom
  absorber_rate  = 1.0,  ! fs^-1
  absorber_power = 4,

  ! Coupling and IO
  want_coupling   = .true.,
  use_exponential = .false.,
  out_prefix      = 'hat_splitop',
  hdf5            = .true.,
  write_initial    = .true.,
  checkpoint_every = 0,       ! steps; 0 disables versioned restart files
  restart_from_checkpoint = .false.,
  parallel_hdf5    = .false., ! needs USE_PARALLEL_HDF5=1 build

  ! -------------------------------------------------------------------------
  ! Stochastic potential modulation: bath acts directly on the diabatic wells
  !
  ! bath_pot_mode:
  !   0 = off
  !   1 = coordinate shift:      V_j = k_j/2 * (x - x_j - R_t)^2
  !   2 = curvature modulation:  V_j = (k_j + R_t)/2 * (x - x_j)^2
  !   3 = enthalpy modulation:   V_j = k_j/2 * (x - x_j)^2 + R_t
  !
  ! bath_pot_sigma:
  !   Std dev of R_t (units depend on mode):
  !     mode 1 -> length, mode 2 -> spring-constant, mode 3 -> energy
  !
  ! bath_pot_colored + bath_pot_fwhm:
  !   If colored, R_t is OU with correlation time tau_c = 2 / bath_pot_fwhm
  !
  ! bath_pot_reactant / bath_pot_product:
  !   Independent on/off switches for applying modulation to each diabatic surface.
  !
  ! bath_pot_coupled:
  !   If .true., the same R_t drives both surfaces (correlated bath).
  !   If .false., independent R_t^R and R_t^P are used.
  !
  bath_pot_mode     = 1,
  bath_pot_sigma    = 0.396883,
  bath_pot_colored  = .false.,
  bath_pot_fwhm     = 10.3353,
  bath_pot_reactant = .false.,
  bath_pot_product  = .true.,
  bath_pot_coupled  = .true.,
/
